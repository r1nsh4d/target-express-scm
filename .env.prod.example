# Copy to .env.prod on the server and fill in. Never commit the filled copy.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod

# --- Ports on the host -------------------------------------------------------
# Only TX_HTTP_PORT is actually published, and only on 127.0.0.1.
# Change it if the preflight check shows 18080 taken by Laam or anything else.
TX_HTTP_PORT=18080

# Used only if you uncomment the port blocks in docker-compose.prod.yml to
# attach a database or storage client from the host.
TX_DB_PORT=55432
TX_MINIO_CONSOLE_PORT=19001

# --- Database ----------------------------------------------------------------
POSTGRES_USER=targetexpress
POSTGRES_DB=targetexpress
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Application -------------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=

# The public origin the app is served from, used for customer tracking links.
PUBLIC_BASE_URL=https://targetexpress.example.com
CORS_ORIGINS=https://targetexpress.example.com

# --- Object storage (proof-of-delivery photographs) --------------------------
# Hetzner Object Storage is S3-compatible. Create a bucket in the Hetzner
# console, generate S3 credentials, and set the endpoint for its location:
#   Falkenstein  https://fsn1.your-objectstorage.com
#   Nuremberg    https://nbg1.your-objectstorage.com
#   Helsinki     https://hel1.your-objectstorage.com
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=target-express
# Set if the bucket is fronted by a CDN or custom domain; otherwise leave blank
# and objects are read straight from the endpoint.
S3_PUBLIC_BASE_URL=

# --- Optional ----------------------------------------------------------------
ANTHROPIC_API_KEY=
